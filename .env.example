# ── 沸点创意 Boiling Point 环境变量 ─────────────────────────
# 复制为 .env 后按需修改

# API 服务端口
PORT=8787

# SQLite 数据文件
BOILING_DB=data/boiling.db

# 每日抓取条数（默认 10）
BOILING_TOP_N=10

# 排序指标：play=播放量 / engage=互动量
BOILING_METRIC=play

# 每日自动执行时间（24 小时制，默认 09:00）
BOILING_CRON_HOUR=9

# 数据源模式：
#   auto      = 真实抓取优先，失败自动降级仿真（默认，推荐）
#   live      = 只用真实接口，失败即报错
#   simulated = 只用内置仿真引擎（离线演示）
BOILING_DATA_MODE=auto

# ── B站公开接口（0 预算默认方案：免 Key 免签名，2026-10 实测可用）──
# 注意 ps=50 不只影响榜单：标题打分器的「基准库」也来自这里，
# 样本越多，打分结论里的占比数据越可信 —— 不要改小。
CUSTOM_API_URL=https://api.bilibili.com/x/web-interface/popular?ps=50&pn=1
CUSTOM_API_METHOD=GET
CUSTOM_API_AUTH=none
CUSTOM_API_LIST_PATH=data.list
CUSTOM_DURATION_UNIT=s
CUSTOM_API_MAP={"id":"bvid","title":"title","duration":"duration","play":"stat.view","digg":"stat.like","comment":"stat.reply","share":"stat.share","collect":"stat.favorite","author":"owner.name","url":"short_link_v2","createTime":"pubdate","fans":"stat.coin"}

# ── 真实抖音数据接入（可选，三选一） ──────────────────────
#
# 【通道 A】抖音官方热搜词榜 —— 免 Key、开箱即用
#   无需任何配置。只提供「今日热搜话题」（50 条真实词 + 热度值），
#   不提供视频级播放数据。视频榜仍会降级为仿真。
#
# 【通道 B】第三方数据服务（新抖 / 蝉妈妈 / 飞瓜 / 自研采集服务）
#   拿到「视频级播放量/互动量」的途径之一，需要对方提供 Base 地址。
# DOUYIN_API_BASE=https://your-douyin-api.com/api/v1/douyin
# DOUYIN_API_KEY=your_api_key_here
# DOUYIN_TIMEOUT_MS=8000
#
# 【通道 C】自定义数据源（推荐，零改代码，优先级最高）
#   任何能返回 JSON 的 HTTP 端点都能接，用字段映射对齐即可。
# CUSTOM_API_URL=
# CUSTOM_API_METHOD=GET                     # GET | POST
# CUSTOM_API_KEY=                           # 凭据值
# CUSTOM_API_AUTH=bearer                    # bearer | appcode | raw | none
#      bearer  -> Authorization: Bearer <key>    （多数海外服务）
#      appcode -> Authorization: APPCODE <key>   （阿里云市场 / 京东万象）
#      raw     -> Authorization: <key>           （对方要求完整值，如 "ApiKey xxx"）
#      none    -> 不发 Authorization（凭据走 query 或自定义 header）
# CUSTOM_API_HEADERS={}                     # 额外请求头，JSON
# CUSTOM_API_BODY={"size":{{limit}},"date":"{{date}}"}   # POST 体，支持 {{limit}} {{date}}
# CUSTOM_API_LIST_PATH=data.list            # 列表数组路径，支持 a.b.c
# CUSTOM_DURATION_UNIT=ms                   # 时长单位 ms | s
# CUSTOM_API_TIMEOUT_MS=8000
# CUSTOM_API_MAP={"id":"aweme_id","title":"desc","play":"statistics.play_count","digg":"statistics.digg_count","comment":"statistics.comment_count","share":"statistics.share_count","collect":"statistics.collect_count","author":"author.nickname","fans":"author.follower_count","url":"share_url","music":"music.title","challenges":"text_extra[].cha_name","duration":"duration","createTime":"create_time"}
#
# 说明：challenges 支持 arr[].field 语法（取对象数组的某字段组成字符串数组）。
#       配好 CUSTOM_API_URL 后，Agent 健康分里的「非真实数据」扣分会消失。
#
# ── 已验证可自助接入的视频榜服务（2026-09 实测）────────────
#
# 方案 1｜阿里云市场 · 艾科瑞特 iCREDIT（国内可自助购买，最省事）
#   地址：https://market.aliyun.com/products/57124001/cmapi032414.html
#   购买：0.01 元/次，或 298 元/5000 次（每天 1 次可用 13 年）
#   认证：AppCode（注意是 APPCODE 不是 Bearer）
# CUSTOM_API_URL=https://douyin.market.alicloudapi.com/ai_market/ai_douyin/get_hot_search_data/v1?DOUYIN_TOPIC_1ST=视频榜&DOUYIN_TOPIC_2ND=视频榜
# CUSTOM_API_AUTH=appcode
# CUSTOM_API_KEY=你的AppCode
# CUSTOM_API_LIST_PATH=data.list
#
# 方案 2｜TikHub（按量付费，新账号送 $0.05 体验额度，可先白嫖验证）
#   地址：https://tikhub.io/douyin-api   约 $0.001/次
# CUSTOM_API_URL=https://api.tikhub.io/api/v1/douyin/billboard/videos?count={{limit}}
# CUSTOM_API_AUTH=bearer
# CUSTOM_API_KEY=你的TikHubToken
#
# 方案 3｜自建采集 / 内部数仓（Playwright 或 n8n 中转都可）
# CUSTOM_API_URL=http://127.0.0.1:9000/douyin/top?n={{limit}}
# CUSTOM_API_AUTH=none
#
# 接通后自检：npm run datasource:check
